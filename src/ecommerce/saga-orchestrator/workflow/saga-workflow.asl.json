      "Parameters": {
        "TableName": "${SagasTableName}",
        "Key": {
          "id": {
            "S.$": "$.sagaId"
          }
        },
        "UpdateExpression": "SET steps.#step = :step, updatedAt = :now",
        "ExpressionAttributeNames": {
          "#step": "refundPayment"
        },
        "ExpressionAttributeValues": {
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":step": {
            "M": {
              "status": {
                "S": "COMPENSATED"
              },
              "at": {
                "S.$": "$$.State.EnteredTime"
              }
            }
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.recordError",
          "Next": "CancelOrder"
        }
      ],
      "Next": "CancelOrder"
    },
    "CancelOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${OrderFunctionArn}",
        "Payload": {
          "action": "cancelOrder",
          "input": {
            "orderId.$": "$.ids.orderId",
            "correlationId.$": "$.correlationId"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "States.Timeout",
            "ThrottlingException",
            "ProvisionedThroughputExceededException",
            "TransactionConflictException",
            "InternalServerError",
            "ServiceUnavailable"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 5,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkCompensationFailed"
        }
      ],
      "Next": "RecordCancelOrder",
      "ResultPath": null
    },
    "RecordCancelOrder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${SagasTableName}",
        "Key": {
          "id": {
            "S.$": "$.sagaId"
          }
        },
        "UpdateExpression": "SET steps.#step = :step, updatedAt = :now",
        "ExpressionAttributeNames": {
          "#step": "cancelOrder"
        },
        "ExpressionAttributeValues": {
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":step": {
            "M": {
              "status": {
                "S": "COMPENSATED"
              },
              "at": {
                "S.$": "$$.State.EnteredTime"
              }
            }
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.recordError",
          "Next": "MarkCompensated"
        }
      ],
      "Next": "MarkCompensated"
    },
    "MarkCompensated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${SagasTableName}",
        "Key": {
          "id": {
            "S.$": "$.sagaId"
          }
        },
        "UpdateExpression": "SET #status = :status, updatedAt = :now",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "COMPENSATED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.recordError",
          "Next": "SagaCompensated"
        }
      ],
      "Next": "SagaCompensated"
    },
    "SagaCompensated": {
      "Type": "Fail",
      "Error": "SagaCompensated",
      "Cause": "A step failed and all completed steps were compensated"
    },
    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${SagasTableName}",
        "Key": {
          "id": {
            "S.$": "$.sagaId"
          }
        },
        "UpdateExpression": "SET #status = :status, updatedAt = :now, failedStep = :failedStep, #error = :error, errorCause = :cause",
        "ExpressionAttributeNames": {
          "#status": "status",
          "#error": "error"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "FAILED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":failedStep": {
            "S": "createOrder"
          },
          ":error": {
            "S.$": "$.error.Error"
          },
          ":cause": {
            "S.$": "States.JsonToString($.error)"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.recordError",
          "Next": "SagaFailed"
        }
      ],
      "Next": "SagaFailed"
    },
    "SagaFailed": {
      "Type": "Fail",
      "Error": "SagaFailed",
      "Cause": "The first step failed; nothing to compensate"
    },
    "MarkCompensationFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${SagasTableName}",
        "Key": {
          "id": {
            "S.$": "$.sagaId"
          }
        },
        "UpdateExpression": "SET #status = :status, updatedAt = :now, compensationError = :error, compensationCause = :cause",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "COMPENSATION_FAILED"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          },
          ":error": {
            "S.$": "$.error.Error"
          },
          ":cause": {
            "S.$": "States.JsonToString($.error)"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.recordError",
          "Next": "CompensationFailed"
        }
      ],
      "Next": "CompensationFailed"
    },
    "CompensationFailed": {
      "Type": "Fail",
      "Error": "CompensationFailed",
      "Cause": "Compensation failed; manual intervention required"
    }
  }
}
