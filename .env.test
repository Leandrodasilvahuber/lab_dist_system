# Variáveis para rodar contra o LocalStack (npm run localstack:start)
# Uso: set -a; source .env.test; set +a
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Endpoint do LocalStack (DynamoDB, Step Functions, EventBridge)
AWS_ENDPOINT=http://localhost:4566

# Nomes das tabelas criadas por npm run seed:local
PRODUCTS_TABLE=products
ORDERS_TABLE=orders
PAYMENTS_TABLE=payments
STOCK_RESERVATIONS_TABLE=stock-reservations
INVENTORY_TABLE=inventory
SAGAS_TABLE=sagas

PAYMENT_MAX_AMOUNT=10000
LOG_LEVEL=info

# Chave das rotas de admin no local-server (opcional; sem ela as rotas ficam abertas).
# Para deixá-la fixa, prefira o arquivo .env (fora do git), carregado por npm run local-server,
# com o hash gerado por npm run admin:hash em vez da chave em texto puro.
# ADMIN_API_KEY_HASH='scrypt$<salt>$<hash>'
