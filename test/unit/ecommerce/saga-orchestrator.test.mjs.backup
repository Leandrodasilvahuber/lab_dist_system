import { describe, it } from 'node:test';
import assert from 'node:assert';

// Importação dinâmica para evitar problemas de dependências complexas
async function loadSagaExecutor() {
  const { SagaExecutor } = await import('../../../src/ecommerce/saga-orchestrator/src/services/index.js');
  return SagaExecutor;
}

describe('SagaExecutor', () => {
  it('should export SagaExecutor class', async () => {
    const SagaExecutor = await loadSagaExecutor();
    assert.ok(SagaExecutor);
    assert.strictEqual(typeof SagaExecutor, 'function');
  });

  it('should create SagaExecutor instance', async () => {
    const SagaExecutor = await loadSagaExecutor();
    const dbClient = {};
    const eventBridgeClient = {};
    const stepFunctionsClient = {};
    const sagaExecutor = new SagaExecutor(dbClient, eventBridgeClient, stepFunctionsClient);
    assert.ok(sagaExecutor);
    assert.strictEqual(sagaExecutor.constructor, SagaExecutor);
  });

  it('should have executeSaga method on instance', async () => {
    const SagaExecutor = await loadSagaExecutor();
    const dbClient = {};
    const eventBridgeClient = {};
    const stepFunctionsClient = {};
    const sagaExecutor = new SagaExecutor(dbClient, eventBridgeClient, stepFunctionsClient);
    assert.strictEqual(typeof sagaExecutor.executeSaga, 'function');
  });

  it('should have executeCompensation method on instance', async () => {
    const SagaExecutor = await loadSagaExecutor();
    const dbClient = {};
    const eventBridgeClient = {};
    const stepFunctionsClient = {};
    const sagaExecutor = new SagaExecutor(dbClient, eventBridgeClient, stepFunctionsClient);
    assert.strictEqual(typeof sagaExecutor.executeCompensation, 'function');
  });
});